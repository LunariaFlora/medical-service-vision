[Unit]
Description=RoboCup H7 scan collector
After=local-fs.target

[Service]
Type=simple
# Replace USERNAME and /opt/robocup-vision with the actual account and directory.
User=USERNAME
SupplementaryGroups=dialout video
WorkingDirectory=/opt/robocup-vision
ExecStart=/opt/robocup-vision/host/.venv/bin/python /opt/robocup-vision/host/app.py --config /opt/robocup-vision/host/config.json
# USB reconnect is handled inside app.py. A process restart starts a new mission.
Restart=no
TimeoutStopSec=20
UMask=0027

[Install]
WantedBy=multi-user.target
